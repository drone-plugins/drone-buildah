FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1@sha256:290a37c85b4284d2c11fa0778e5da79643d912a1f5a57d6f701b77644503b7e7 AS hhi-ca-certificates
RUN apk add --no-cache 'ca-certificates>=20261020-r0'

FROM harness0.harness.io/oci/docker_artifacts/hhi/buildah:1.46.0@sha256:89bf8a0e2c1b9fa6249d206afc5c1fcebdaa056d01f976384549e1cfdc7a6b72

# Use VFS since fuse does not work. The previous quay.io/buildah/stable base shipped a
# per-user storage config for the build user; the HHI base only has the system one
# (runroot=/run/containers/storage), which makes rootless buildah fail with
# "mkdir /run/containers: permission denied". This restores the previous behaviour.
RUN mkdir -p /home/build/.config/containers \
 && echo "driver=\"vfs\"" > /home/build/.config/containers/storage.conf

# Required since buildah 1.45 (this base ships 1.46.0; earlier bases shipped 1.43).
# `buildah build` now mounts an overlay over the build context and keeps its
# scaffolding in TMPDIR (default /var/tmp). That mount fails with "mounting an overlay
# over build context directory ... invalid argument" when /var/tmp is on the
# container's own overlay rootfs, for root and non-root, privileged or not.
# A volume puts /var/tmp on a separate filesystem. Build output is unchanged.
VOLUME /var/tmp

USER build
WORKDIR /home/build
ENV STORAGE_DRIVER=vfs

# Add plugin binaries
ADD release/linux/amd64/drone-docker /bin/
ADD release/linux/amd64/drone-ecr /bin/
ENTRYPOINT ["/bin/drone-ecr"]

COPY --from=hhi-ca-certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
